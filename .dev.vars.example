# ──────────────────────────────────────────────────────────────────────
# قالب اجرای محلی wrangler — این فایل را به «.dev.vars» کپی کنید و
# مقادیر «تستی» بگذارید. خود .dev.vars در .gitignore است و هرگز
# commit نمی‌شود. مقادیر زیر فقط placeholder هستند.
# ──────────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=123456:TEST-TOKEN-PLACEHOLDER-0123456789
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret-0123456789abcdef
ADMIN_USER_ID=100200300
CHANNEL_ID=-1001234567890
PRICE_API_KEY=
# stub (پیشفرض) | jahankhahan (نیازمند PRICE_API_BASE_URL)
PRICE_PROVIDER=stub
# برای jahankhahan: https://nerkh.jahankhahan.shop/data/live.json
PRICE_API_BASE_URL=
# لینک عمومی کانال برای دکمه «عضویت» (اختیاری — فقط https://t.me/...)
# اگر خالی و CHANNEL_ID=@username باشد، لینک از خود username ساخته می‌شود
CHANNEL_LINK=
# لینک خارجی پشتیبانی (اختیاری) — خالی = سیستم تیکت داخلی ربات
SUPPORT_LINK=

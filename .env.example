# ──────────────────────────────────────────────────────────────────────
# iran-market-price-bot — این فایل فقط «نام» متغیرها را نشان می‌دهد.
# هیچ مقدار واقعی (Secret/Token) در Git قرار نمی‌گیرد.
#
# نحوه تنظیم مقادیر واقعی:
#   • Production → `wrangler secret put NAME`  (یا Dashboard → Workers → Settings)
#   • اجرای محلی  → فایل .dev.vars (gitignore است) از روی .dev.vars.example
# ──────────────────────────────────────────────────────────────────────

# --- Secrets (فقط از طریق Cloudflare Secrets) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USER_ID=
CHANNEL_ID=
PRICE_API_KEY=

# --- تنظیمات غیر حساس (Cloudflare Vars) ---
# stub (پیشفرض) | jahankhahan (نیازمند PRICE_API_BASE_URL)
PRICE_PROVIDER=stub
# برای jahankhahan: https://nerkh.jahankhahan.shop/data/live.json
PRICE_API_BASE_URL=

# --- اعتبارسنجی متقاطع (اختیاری — غایب = پیشفرض) ---
# مقایسهٔ منبع با مرجع قبل از انتشار مقدار تغییرکرده (docs/SOURCES.md)
# فعال(true) | غیرفعال(false)
CROSS_CHECK_ENABLED=true
# آستانهٔ اختلاف درصدی: ارز / طلا و سکه / تتر
CROSS_CHECK_FX_TOLERANCE_PCT=2.5
CROSS_CHECK_GOLD_TOLERANCE_PCT=5
CROSS_CHECK_TETHER_TOLERANCE_PCT=3
# مرجعها (فقط https — خالی = پیشفرض کد)
# TGJU_REFERENCE_URL=https://call1.tgju.org/ajax.json
# WALLEX_MARKETS_URL=https://api.wallex.ir/v1/depth?symbol=USDTTMN
